# Database
DATABASE_URL=postgresql://curator_board:curator_board@localhost:5436/curator_board
POSTGRES_USER=curator_board
POSTGRES_PASSWORD=curator_board
POSTGRES_DB=curator_board

# API auth (shared between board and agent)
BOARD_API_SECRET=<openssl rand -hex 32>

# Admin auth (human)
ADMIN_PASSWORD=<choose-a-strong-admin-password>
# Optional explicit session-signing secret for admin cookies.
# Defaults to BOARD_API_SECRET, then ADMIN_PASSWORD if omitted.
ADMIN_SESSION_SECRET=

# Supadata (video metadata — https://supadata.ai)
SUPADATA_API_KEY=

# Node
NODE_ENV=development
