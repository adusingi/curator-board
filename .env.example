# =============================================================================
# REQUIRED — board will not start without these
# =============================================================================

DATABASE_URL=postgresql://curator_board:curator_board@localhost:5436/curator_board

# Random secret shared between the board and the bot (generate with: openssl rand -hex 32)
BOARD_API_SECRET=

# Password for the /admin UI
ADMIN_PASSWORD=

# =============================================================================
# REQUIRED for Docker Compose deployments
# (postgres service reads these; not needed for Vercel/managed-DB deployments)
# =============================================================================

POSTGRES_USER=curator_board
POSTGRES_PASSWORD=curator_board
POSTGRES_DB=curator_board

# =============================================================================
# OPTIONAL
# =============================================================================

# Explicit secret for signing admin session cookies.
# Defaults to BOARD_API_SECRET if omitted.
ADMIN_SESSION_SECRET=

# Set to "production" in production deployments.
NODE_ENV=development
