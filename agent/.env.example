# =============================================================================
# REQUIRED — bot will not start without these
# =============================================================================

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram user ID — get it from @userinfobot
# Set to 0 to allow any user (not recommended for production)
TELEGRAM_OWNER_ID=

# URL of the running board (use http://board:3000 in Docker Compose)
BOARD_API_URL=http://localhost:3000

# Must match BOARD_API_SECRET in the board environment
BOARD_API_SECRET=

# =============================================================================
# OPTIONAL — AI categorization
# Without any API key the bot will assign every link to the "other" category
# =============================================================================

# Provider selection: auto | anthropic | openai | none
# "auto" detects based on which API key is present (Anthropic preferred)
AI_PROVIDER=auto

# Generic model override for the selected provider.
# If blank, a sensible default is used per provider.
AI_MODEL=

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Legacy Anthropic-specific model override. AI_MODEL takes precedence when set.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# OpenAI — https://platform.openai.com
OPENAI_API_KEY=

# =============================================================================
# OPTIONAL — metadata enrichment
# Improves title/description quality for YouTube and other social URLs
# =============================================================================

# Supadata — https://supadata.ai
SUPADATA_API_KEY=
